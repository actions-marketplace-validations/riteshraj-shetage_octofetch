{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/riteshraj-shetage/octofetch/main/octofetch.schema.json",
  "title": "OctofetchConfig",
  "type": "object",
  "required": ["outputFile", "graphqlUrl"],
  "properties": {
    "outputFile": {
      "type": "string",
      "description": "The file path to output the fetched payload to..."
    },
    "graphqlUrl": {
      "type": "string",
      "description": "The URL of the GraphQL endpoint to fetch data from."
    }
  }
}
