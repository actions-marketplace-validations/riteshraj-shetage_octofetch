{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Octofetch Configuration Schema",
  "description": "Schema for validating Octofetch's configuration objects.",
  "type": "object",
  "required": ["targetNode"],
  "anyOf": [{ "required": ["fields"] }, { "required": ["presets"] }],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://raw.githubusercontent.com/riteshraj-shetage/octofetch/main/octofetch.schema.json"
    },
    "targetNode": {
      "type": "string",
      "enum": [
        "user",
        "repository",
        "organization",
        "viewer",
        "search",
        "repositoryOwner",
        "topic"
      ]
    },
    "presets": {
      "description": "Pre-configured fields for common use-cases.",
      "anyOf": [
        { "$ref": "#/$defs/presetList" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/presetList" },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "args": {
      "type": "object",
      "properties": {
        "login": { "type": "string" },
        "owner": { "type": "string" },
        "name": { "type": "string" },
        "first": { "type": ["integer", "string"] },
        "last": { "type": ["integer", "string"] },
        "after": { "type": "string" },
        "before": { "type": "string" },
        "orderBy": {
          "type": "object",
          "properties": {
            "field": { "type": "string" },
            "direction": { "type": "string", "enum": ["ASC", "DESC"] }
          }
        },
        "ownerAffiliations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["OWNER", "COLLABORATOR", "ORGANIZATION_MEMBER"]
          }
        },
        "privacy": {
          "type": "string",
          "enum": ["PUBLIC", "PRIVATE", "INTERNAL"]
        },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "states": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["OPEN", "CLOSED", "MERGED", "DRAFT"]
              },
              { "type": "string" }
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "fields": {
      "type": "array",
      "items": {
        "anyOf": [{ "type": "string" }, { "type": "object" }]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "presetList": {
      "type": "string",
      "enum": [
        "user-profile",
        "user-metrics",
        "user-contribution-calendar",
        "user-top-repositories",
        "user-top-languages"
      ]
    }
  }
}
